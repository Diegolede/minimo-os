# Historial del portapapeles: wl-paste avisa cada copia (sin sondeo) y cliphist la guarda.
# Dos vigilantes (recomendación de cliphist): uno para texto y otro para imágenes; sin --type,
# wl-paste elige un solo tipo y las imágenes copiadas desde apps se perdían.
[Unit]
Description=Minimo OS: historial del portapapeles (cliphist)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Solo dentro de Hyprland: si la PC también tiene KDE Plasma (u otro escritorio), allí no arranca.
ExecCondition=/bin/sh -c 'test -S "$${XDG_RUNTIME_DIR}/hypr/$${HYPRLAND_INSTANCE_SIGNATURE}/.socket.sock"'
ExecStart=/bin/sh -c 'wl-paste --type text --watch cliphist -max-items 200 store & wl-paste --type image --watch cliphist -max-items 200 store & wait'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
